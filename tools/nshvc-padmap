#!/bin/sh
# nshvc-padmap GAMECONTROLLERDB.txt: writes src/host/common/pad_db_windows.h and
# pad_db_linux.h from SDL_GameControllerDB's gamecontrollerdb.txt (zlib licence, see NOTICE).
# Each device becomes "VVVVPPPPRRRR|name|mapping": vendor, product and version from its GUID, and only the
# mapping fields the engine reads (the 14 buttons, the d-pad, the triggers and both sticks).
set -e
[ $# -eq 1 ] || { echo "usage: nshvc-padmap GAMECONTROLLERDB.txt" >&2; exit 2; }
db=$1
out=$(cd "$(dirname "$0")/.." && pwd)/src/host/common
gen() {   # SECTION NEXT_SECTION OUTFILE ARRAY
  awk -v from="# $1" -v to="# $2" -v array="$4" '
    BEGIN { print "/* generated by tools/nshvc-padmap from SDL_GameControllerDB (zlib licence); do not edit */"
            print "static const char *const " array "[] = {" }
    $0 == from { on = 1; next }
    $0 == to { on = 0 }
    !on || /^#/ || $0 == "" { next }
    {
      n = split($0, f, ",")
      g = f[1]
      if (length(g) != 32) next
      vid = substr(g, 11, 2) substr(g, 9, 2)
      pid = substr(g, 19, 2) substr(g, 17, 2)
      ver = substr(g, 27, 2) substr(g, 25, 2)
      if (vid == "0000") next
      name = f[2]; gsub(/["\\|]/, "", name)
      m = ""
      for (i = 3; i <= n; i++) {
        split(f[i], kv, ":")
        k = kv[1]
        if (k ~ /^(a|b|x|y|back|start|leftshoulder|rightshoulder|leftstick|rightstick|lefttrigger|righttrigger|dpup|dpdown|dpleft|dpright|leftx|lefty|rightx|righty)$/ && kv[2] != "")
          m = m (m == "" ? "" : ",") f[i]
      }
      if (m == "") next
      printf "    \"%s%s%s|%s|%s\",\n", vid, pid, ver, name, m
    }
    END { print "};" }' "$db" > "$3"
}
gen "Windows" "Mac OS X" "$out/pad_db_windows.h" pad_db_windows
gen "Linux" "Android" "$out/pad_db_linux.h" pad_db_linux
