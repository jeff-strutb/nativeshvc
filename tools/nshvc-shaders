#!/usr/bin/env python3
"""nshvc-shaders SRC_DIR OUT_DIR: compiles a game's shaders (*.shade) for every
backend, into OUT_DIR, as NAME.spv, NAME.metal and NAME.dxil. A shader is a
fragment-only subset of GLSL 4.5 that defines vec4 shade(vec2 uv); the engine
provides nshvc_image(ivec2) and nshvc_input(int). Alpha 0 leaves the pixel."""
import os, re, shutil, subprocess, sys, tempfile

PRE = '''#version 450
layout(std430, binding = 1) readonly buffer TB { uint nshvc_store[]; };
layout(location = 0) in vec2 nshvc_uv;
layout(location = 1) flat in uint nshvc_colour;
layout(location = 0) out uint nshvc_out;
layout(push_constant) uniform U { float w, h; uint base, tw, th, p0, p1, p2; vec4 inputs[2]; } nshvc_u;
vec4 nshvc_image(ivec2 p) {
    if (nshvc_u.tw == 0u) return vec4(float((nshvc_colour >> 16) & 255u), float((nshvc_colour >> 8) & 255u), float(nshvc_colour & 255u), 255.0) / 255.0;
    uint x = uint(clamp(p.x, 0, int(nshvc_u.tw) - 1)), y = uint(clamp(p.y, 0, int(nshvc_u.th) - 1));
    uint c = nshvc_store[nshvc_u.base + y * nshvc_u.tw + x];
    return vec4(float((c >> 16) & 255u), float((c >> 8) & 255u), float(c & 255u), float(c >> 24)) / 255.0;
}
float nshvc_input(int i) { return nshvc_u.inputs[i / 4][i % 4]; }
#line 1
'''
POST = '''
void main() {
    vec4 c = shade(nshvc_uv);
    if (c.a <= 0.0) discard;
    uvec3 v = uvec3(clamp(c.rgb, 0.0, 1.0) * 255.0 + 0.5);
    nshvc_out = 0xFF000000u | v.r << 16 | v.g << 8 | v.b;
}
'''

def run(*cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        sys.exit(f'{cmd[0]}: {r.stdout}{r.stderr}')
    return r.stdout

def main():
    if len(sys.argv) != 3:
        sys.exit(__doc__)
    src, out = sys.argv[1:]
    os.makedirs(out, exist_ok=True)
    dxc = shutil.which('dxc') or shutil.which('dxc', path=os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'build', 'tools', 'dxc', 'bin'))
    with tempfile.TemporaryDirectory() as tmp:
        for n in sorted(os.listdir(src)):
            if not n.endswith('.shade'):
                continue
            name = n[:-6]
            with open(os.path.join(src, n)) as f:
                body = f.read()
            frag = os.path.join(tmp, name + '.frag')
            with open(frag, 'w') as f:
                f.write(PRE + body + POST)
            spv = os.path.join(out, name + '.spv')
            run('glslangValidator', '-V', '-o', spv, frag)
            msl = run('spirv-cross', spv, '--msl', '--msl-version', '20000')
            # the engine binds the block at buffer 1 and the store at buffer 2
            msl = re.sub(r'(constant U& \w+) \[\[buffer\(\d+\)\]\]', r'\1 [[buffer(1)]]', msl)
            msl = re.sub(r'(const device TB& \w+) \[\[buffer\(\d+\)\]\]', r'\1 [[buffer(2)]]', msl)
            with open(os.path.join(out, name + '.metal'), 'w') as f:
                f.write(msl)
            if not dxc:
                sys.exit('nshvc-shaders: dxc is not installed: the D3D12 shaders cannot be built')
            hlsl = os.path.join(tmp, name + '.hlsl')
            with open(hlsl, 'w') as f:
                f.write(run('spirv-cross', spv, '--hlsl', '--shader-model', '60'))
            run(dxc, '-T', 'ps_6_0', '-E', 'main', '-Fo', os.path.join(out, name + '.dxil'), hlsl)

if __name__ == '__main__':
    main()
