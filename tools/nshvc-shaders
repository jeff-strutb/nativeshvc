#!/usr/bin/env python3
"""nshvc-shaders SRC_DIR OUT_DIR [RENDER]: compiles a game's shaders (*.shade)
for every backend, into OUT_DIR, as NAME.spv, NAME.metal and NAME.dxil. DXIL
needs dxc: without it, the DXIL is left out with a warning, an error only when
RENDER, the build's renderer, is d3d12.

A shader is a fragment-only subset of GLSL 4.5 that defines
vec4 shade(vec2 uv): the colour of a draw list's pixel at the material's
texture coordinate uv, its alpha how much of the pixel it covers (0 none).
It takes the place of the fragment stage of the engine's draw-list program
(src/engine/shaders/list_fs.glsl), so it reads that program's uniforms and inputs,
and its colour goes through the colour maths of the picture's settings
(src/engine/shaders/maths.glsl) as that program's does:
the engine provides nshvc_image(ivec2), the material's image's texel (an
indexed image's through the palette, 0 see-through; the vertices' colour
without an image), and nshvc_input(int), its eight inputs."""
import os, shutil, subprocess, sys, tempfile

PRE = '''#version 450
#extension GL_GOOGLE_include_directive : require
layout(std140, binding = 0) uniform D { vec4 f[8]; ivec4 i[8]; } nshvc_u;
layout(std430, binding = 1) readonly buffer W { uint w[]; } nshvc_data;
layout(binding = 2) uniform sampler2D nshvc_tex;
layout(binding = 3) uniform sampler2D nshvc_palette;
layout(binding = 5) uniform usampler2D nshvc_index;
layout(binding = 11) uniform sampler2D nshvc_sub;
layout(binding = 12) uniform sampler2D nshvc_aux;
layout(location = 0) in vec2 nshvc_uv;
layout(location = 1) in vec4 nshvc_colour;
layout(location = 2) noperspective in vec2 nshvc_p;
layout(location = 0) out vec4 nshvc_out;
#define MATHS_U nshvc_u
#define MATHS_DATA nshvc_data
#define MATHS_SUB nshvc_sub
#define MATHS_AUX nshvc_aux
#include "maths.glsl"
int nshvc_row_palette() {
    if (nshvc_u.i[7].x > 0) return nshvc_u.i[7].x - 1;
    int r = clamp(int(floor(nshvc_p.y)), 0, int(nshvc_u.f[1].y) - 1), k = nshvc_u.i[7].w + r * 2;
    int first = int(nshvc_data.w[k]), n = int(nshvc_data.w[k + 1]), pal = int(nshvc_data.w[first + 1]);
    for (int i = 1; i < n; i++)
        if (nshvc_p.x >= float(int(nshvc_data.w[first + i * 2])))
            pal = int(nshvc_data.w[first + i * 2 + 1]);
    return pal;
}
vec4 nshvc_image(ivec2 p) {
    if (nshvc_u.i[0].w == 0) return nshvc_colour;
    p = clamp(p, ivec2(0), nshvc_u.i[0].yz - 1);
    if (nshvc_u.i[1].x != 0) {
        uint x = texelFetch(nshvc_index, p, 0).r;
        return x != 0u ? vec4(texelFetch(nshvc_palette, ivec2(int(x), nshvc_row_palette()), 0).rgb, 1.0) : vec4(0.0);
    }
    return texelFetch(nshvc_tex, p, 0);
}
float nshvc_input(int i) { return nshvc_u.f[4 + i / 4][i % 4]; }
#line 1
'''
POST = '''
void main() {
    vec4 c = shade(nshvc_uv);
    int n = int(clamp(c.a, 0.0, 1.0) * nshvc_u.f[0].z + 0.5);
    if (n <= 0) discard;
    gl_SampleMask[0] = n >= 31 ? -1 : int((1u << uint(n)) - 1u);
    nshvc_out = nshvc_maths(clamp(c.rgb, 0.0, 1.0), nshvc_u.f[3].x, nshvc_p);
}
'''

def run(*cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode:
        sys.exit(f'{cmd[0]}: {r.stdout}{r.stderr}')
    return r.stdout

def main():
    engine = os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'src', 'engine', 'shaders')
    if len(sys.argv) not in (3, 4):
        sys.exit(__doc__)
    src, out = sys.argv[1:3]
    render = sys.argv[3] if len(sys.argv) == 4 else ''
    warned = False
    os.makedirs(out, exist_ok=True)
    dxc = os.environ.get('DXC') or shutil.which('dxc') or shutil.which('dxc', path=os.path.join(os.path.dirname(os.path.abspath(__file__)), '..', 'build', 'tools', 'dxc', 'bin'))
    with tempfile.TemporaryDirectory() as tmp:
        for n in sorted(os.listdir(src)):
            if not n.endswith('.shade'):
                continue
            name = n[:-6]
            with open(os.path.join(src, n)) as f:
                body = f.read()
            frag = os.path.join(tmp, name + '.frag')
            with open(frag, 'w') as f:
                f.write(PRE + body + POST)
            spv = os.path.join(out, name + '.spv')
            run('glslangValidator', '-V', '-DFRAG', '-I' + engine, '-o', spv, frag)
            # the bindings as the engine's programs have them: buffers 0 and 1, textures and samplers 2, 3, 5, 11 and 12
            with open(os.path.join(out, name + '.metal'), 'w') as f:
                f.write(run('spirv-cross', spv, '--msl', '--msl-version', '20100', '--msl-decoration-binding'))
            if not dxc:
                if render == 'd3d12':
                    sys.exit('nshvc-shaders: dxc is not installed: the D3D12 shaders cannot be built')
                if not warned:
                    print('nshvc-shaders: warning: dxc is not installed: the shaders are built without DXIL (D3D12)', file=sys.stderr)
                    warned = True
                continue
            hlsl = os.path.join(tmp, name + '.hlsl')
            with open(hlsl, 'w') as f:
                f.write(run('spirv-cross', spv, '--hlsl', '--shader-model', '60'))
            run(dxc, '-T', 'ps_6_0', '-E', 'main', '-Fo', os.path.join(out, name + '.dxil'), hlsl)

if __name__ == '__main__':
    main()
