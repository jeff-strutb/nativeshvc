#version 450
/* The pause's backdrop (rr_backdrop_make): the frame's cells, a box along
   an axis, the tint; c holds two arrays of w x h cells, at src and dst. */
layout(local_size_x = 32, local_size_y = 8) in;
layout(std430, set = 0, binding = 0) buffer C { vec4 c[]; };
layout(std430, set = 0, binding = 1) readonly buffer F { uint f[]; };
layout(std430, set = 0, binding = 2) writeonly buffer O { uint o[]; };
layout(push_constant) uniform P {
    uint mode, tw, th, cell, w, h, r, dx, dy, src, dst, pad;
    vec4 tint;
} p;

void main()
{
    uvec2 g = gl_GlobalInvocationID.xy;
    uint at = g.y * p.w + g.x;
    if (g.x >= p.w || g.y >= p.h)
        return;
    if (p.mode == 0u) {
        vec4 s = vec4(0.0);
        float n = 0.0;
        for (uint y = g.y * p.cell; y < (g.y + 1u) * p.cell && y < p.th; y++)
            for (uint x = g.x * p.cell; x < (g.x + 1u) * p.cell && x < p.tw; x++) {
                uint v = f[y * p.tw + x];
                s += vec4(float((v >> 16) & 255u), float((v >> 8) & 255u), float(v & 255u), 255.0);
                n += 1.0;
            }
        c[p.dst + at] = s / n;
    } else if (p.mode == 1u) {
        vec4 s = vec4(0.0);
        int r = int(p.r);
        for (int i = -r; i <= r; i++) {
            int x = clamp(int(g.x) + i * int(p.dx), 0, int(p.w) - 1), y = clamp(int(g.y) + i * int(p.dy), 0, int(p.h) - 1);
            s += c[p.src + uint(y) * p.w + uint(x)];
        }
        c[p.dst + at] = s / float(2 * r + 1);
    } else {
        vec3 v = clamp(floor(c[p.src + at].rgb * (1.0 - p.tint.a) + p.tint.rgb * p.tint.a + 0.5), 0.0, 255.0);
        o[at] = 0xFF000000u | uint(v.r) << 16 | uint(v.g) << 8 | uint(v.b);
    }
}
