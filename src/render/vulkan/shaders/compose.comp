#version 450
#extension GL_GOOGLE_include_directive : require
// The Vulkan backend's prelude to compose_body.h: the frame's description
// in the staging ring at the word offset the push constant gives, the
// picture a storage image, a thread a picture pixel.
layout(local_size_x = 32, local_size_y = 8) in;
layout(std430, set = 0, binding = 0) readonly buffer Ring { uint ring_w[]; };
layout(set = 0, binding = 1, rgba8) uniform writeonly image2D pic;
layout(push_constant) uniform PC { uint off; } U;
#define CP_FN
#define CP_VAR
#define U32 uint
#define I32 int
#define U_(x) uint(x)
#define I_(x) int(x)
#define FD_(i) ring_w[U.off + (i)]
#include "../../compose_body.h"
void main()
{
    uvec2 g = gl_GlobalInvocationID.xy;
    uint p;
    if (g.x >= FD_(CP_PW) || g.y >= FD_(CP_PH))
        return;
    p = cp_pixel(g.x, g.y);
    imageStore(pic, ivec2(g), vec4(float((p >> 16) & 255u), float((p >> 8) & 255u), float(p & 255u), 255.0) / 255.0);
}
