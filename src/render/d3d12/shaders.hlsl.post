float4 vs(uint i : SV_VertexID) : SV_Position {
  float2 p = float2(float((i << 1) & 2u), float(i & 2u));
  return float4(p * float2(2, -2) + float2(-1, 1), 0, 1); }
uint picture_fs(float4 pos : SV_Position) : SV_Target {
  if (pb_row_kept(uint(pos.y)) != 0u) discard;
  return pb_pixel(uint(pos.x), uint(pos.y)); }
float4 window_fs(float4 pos : SV_Position) : SV_Target {
  uint c = pb_window(uint(pos.x), uint(pos.y));
  return float4(float((c >> 16) & 255u), float((c >> 8) & 255u), float(c & 255u), 255.0) / 255.0; }
cbuffer LU : register(b0) { float lu_w, lu_h; uint lu_base, lu_tw, lu_th; };
struct LO { float4 pos : SV_Position; float2 uv : TEXCOORD0; nointerpolation uint colour : TEXCOORD1; };
LO list_vs(float4 a : POSITION, uint colour : COLOR) {
  LO o; o.pos = float4(a.x / lu_w * 2 - 1, 1 - a.y / lu_h * 2, 0, 1); o.uv = a.zw; o.colour = colour; return o; }
uint list_fs(LO i) : SV_Target {
  if (lu_tw == 0u) return i.colour;
  uint x = uint(clamp(int(floor(i.uv.x)), 0, int(lu_tw) - 1)), y = uint(clamp(int(floor(i.uv.y)), 0, int(lu_th) - 1));
  uint c = pb_tb[lu_base + y * lu_tw + x];
  if (c == 0u) discard;
  return c; }
